---
import type { Clip } from "../data/media";
import TabBar from "./TabBar.astro";
import TabPanel from "./TabPanel.astro";
import VideoPanel from "./VideoPanel.astro";

interface Props {
  sec: string;
  label: string;
  clips: Clip[];
  /** Lay the panels out as a left-to-right flow with chevrons instead of a grid. */
  flow?: boolean;
}

const { sec, label, clips, flow = false } = Astro.props;
---

<TabBar sec={sec} label={label} tabs={clips.map((c) => ({ label: c.tab, group: c.group }))} />
<div class="panel" data-sec={sec}>
  {
    clips.map((clip, i) => (
      <TabPanel sec={sec} i={i}>
        <div class="clip">
          {clip.title && (
            <div class="clip-head">
              <h3>{clip.title}</h3>
            </div>
          )}
          {flow ? (
            <div class="flow">
              {clip.panels.map((p, k) => (
                <>
                  {k > 0 && <span class="flow-arrow" aria-hidden="true" />}
                  <VideoPanel src={p.src} label={p.label} ours={p.ours} aspect={p.aspect} />
                </>
              ))}
            </div>
          ) : (
            <div class={`grid grid${clip.panels.length}`}>
              {clip.panels.map((p) => (
                <VideoPanel src={p.src} label={p.label} ours={p.ours} aspect={p.aspect} />
              ))}
            </div>
          )}
        </div>
      </TabPanel>
    ))
  }
</div>
